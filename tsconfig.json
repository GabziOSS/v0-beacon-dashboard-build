{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "target": "ES6",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", "sst.config.ts", "sst.config.ts"],
  "references": [
    {
      "path": "./repos/civicpulse/packages/weather-charts"
    },
    {
      "path": "./repos/civicpulse/packages/beacon-ui"
    },
    {
      "path": "./repos/civicpulse/packages/chart-kit"
    },
    {
      "path": "./repos/civicpulse/packages/dashboard"
    },
    {
      "path": "./repos/civicpulse/packages/hooks"
    },
    {
      "path": "./repos/civicpulse/packages/types"
    },
    {
      "path": "./repos/civicpulse/packages/data"
    },
    {
      "path": "./repos/scaffolds/apps/nextjs-web-e2e"
    },
    {
      "path": "./repos/civicpulse/apps/beacon"
    }
  ]
}
