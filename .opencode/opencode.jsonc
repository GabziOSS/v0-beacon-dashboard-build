{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-working-memory",
    "@zenobius/opencode-skillful",
    "@tarquinen/opencode-dcp",
    "@openspoon/subtask2",
    "opencode-ignore",
    "@franlol/opencode-md-table-formatter",
    "@ramtinj95/opencode-tokenscope",
