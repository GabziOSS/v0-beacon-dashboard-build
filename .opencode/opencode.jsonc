{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-working-memory",
    "@zenobius/opencode-skillful",
    "@tarquinen/opencode-dcp",
    "@openspoon/subtask2",
    "opencode-ignore",
    "@franlol/opencode-md-table-formatter",
    "@ramtinj95/opencode-tokenscope",
  ],
  "instructions": [
    "./shell_strategy.md",
    "./CLAUDE.md",
    "./AGENT.md",
    "./v0.md",
  ],
  "agent": {
    "explore": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
  },
  "mcp": {
    "nx-mcp": {
      "type": "local",
      "command": ["pnpx", "nx", "mcp"],
      "enabled": true,
    },
  },
}
