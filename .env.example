# Environment Variables for Civic Pulse Alpha
# Copy this file to .env.local and fill in your values

# Application Environment
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Civic Pulse Alpha"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# # Database Configuration
# DATABASE_URL="postgresql://username:password@localhost:5432/civic_pulse_dev"
# DATABASE_POOL_SIZE=10

# # Authentication
# NEXTAUTH_SECRET="your-nextauth-secret-here"
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_PROVIDER_GOOGLE_ID=""
# NEXTAUTH_PROVIDER_GOOGLE_SECRET=""

# # External APIs
# CIVIC_DATA_API_KEY=""
# CIVIC_DATA_API_URL="https://api.civicdata.gov"
# MAPS_API_KEY=""
# ANALYTICS_API_KEY=""

# # Email Service
# SMTP_HOST=""
# SMTP_PORT=587
# SMTP_USER=""
# SMTP_PASS=""
# FROM_EMAIL="noreply@montz.qzz.io"

# # File Storage
# AWS_S3_BUCKET_NAME=""
# AWS_S3_REGION="ap-southeast-1"
# NEXT_PUBLIC_CDN_URL=""

# # Feature Flags
# NEXT_PUBLIC_ENABLE_ANALYTICS=true
# NEXT_PUBLIC_ENABLE_NOTIFICATIONS=true
# NEXT_PUBLIC_ENABLE_BETA_FEATURES=false

# # Rate Limiting
# RATE_LIMIT_REQUESTS_PER_MINUTE=100
# RATE_LIMIT_WINDOW_MS=60000

# # Monitoring & Logging
# SENTRY_DSN=""
# LOG_LEVEL="info"
# ENABLE_REQUEST_LOGGING=true