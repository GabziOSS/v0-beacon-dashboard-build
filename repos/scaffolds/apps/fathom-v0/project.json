{
  "name": "@rie-nexus/fathom-v0",
  "$schema": "../../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "repos/scaffolds/apps/fathom-v0",
  "targets": {
    "build": {
      "executor": "@nx/next:build",
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "outputPath": "repos/scaffolds/apps/fathom-v0/.next"
      }
    },
    "dev": {
      "executor": "@nx/next:server",
      "options": {
        "port": 3002,
        "buildTarget": "@rie-nexus/fathom-v0:build",
        "dev": true
      }
    },
    "start": {
      "executor": "@nx/next:server",
      "options": {
        "port": 3002,
        "buildTarget": "@rie-nexus/fathom-v0:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "repos/scaffolds/apps/fathom-v0"
      }
    }
  }
}
